---
import { projectVisuals, ui } from '../data/site';

interface Props {
  theme: 'live' | 'anonymous' | 'delivery' | 'social';
}

const { theme } = Astro.props;
const config = projectVisuals[theme];
const points = [
  { x: 122, y: 142 },
  { x: 356, y: 98 },
  { x: 590, y: 142 },
  { x: 122, y: 386 },
  { x: 356, y: 430 },
  { x: 590, y: 386 },
];
---

<div class={`project-visual project-visual--${theme}`} aria-hidden="true">
  <div class="visual-meta"><span>{config.code}</span><span>{ui.projectVisual.schematic}</span></div>
  <svg viewBox="0 0 720 520" role="img">
    <defs>
      <pattern id={`grid-${theme}`} width="36" height="36" patternUnits="userSpaceOnUse">
        <path d="M 36 0 L 0 0 0 36" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.12" />
      </pattern>
    </defs>
    <rect width="720" height="520" fill={`url(#grid-${theme})`} />
    <path class="orbit" d="M72 264 C160 48 560 48 648 264 C560 480 160 480 72 264Z" />
    <path class="orbit orbit--inner" d="M166 264 C228 128 492 128 554 264 C492 400 228 400 166 264Z" />
    {points.map((point) => <line class="connector" x1="360" y1="264" x2={point.x} y2={point.y} />)}
    {points.map((point, index) => (
      <g class="node" transform={`translate(${point.x} ${point.y})`}>
        <rect x="-66" y="-28" width="132" height="56" rx="8" />
        <circle cx="-46" cy="0" r="4" />
        <text x="-32" y="4">{config.nodes[index]}</text>
      </g>
    ))}
    <g class="center-node" transform="translate(360 264)">
      <rect x="-76" y="-48" width="152" height="96" rx="12" />
      <text class="center-title" x="0" y="2">{config.center}</text>
      <text class="center-sub" x="0" y="25">{ui.projectVisual.coreSystem}</text>
    </g>
    <circle class="pulse" cx="360" cy="264" r="102" />
  </svg>
  <div class="visual-foot"><span>{ui.projectVisual.flow}</span><i></i></div>
</div>

<style>
  .project-visual {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--visual-live);
    color: var(--text-primary);
    box-shadow: var(--inset-highlight);
  }

  .project-visual--anonymous { background: var(--visual-anonymous); }
  .project-visual--delivery { background: var(--visual-delivery); }
  .project-visual--social { background: var(--visual-social); }

  .visual-meta,
  .visual-foot {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .visual-meta {
    border-bottom: 1px solid var(--line-subtle);
  }

  .visual-meta span:first-child {
    color: var(--accent);
  }

  svg {
    width: 100%;
    height: auto;
  }

  .orbit {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.8;
    stroke-dasharray: 4 8;
    opacity: 0.18;
  }

  .orbit--inner {
    stroke-dasharray: none;
    opacity: 0.12;
  }

  .connector {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 5 7;
    opacity: 0.28;
  }

  .node rect {
    fill: var(--surface-2);
    stroke: var(--visual-node-border);
  }

  .node circle {
    fill: var(--accent);
    opacity: 0.75;
  }

  .node text {
    fill: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .center-node rect {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .center-title {
    fill: var(--on-accent);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 750;
    letter-spacing: -0.03em;
    text-anchor: middle;
  }

  .center-sub {
    fill: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.12em;
    text-anchor: middle;
    opacity: 0.7;
  }

  .pulse {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0;
    transform-origin: 360px 264px;
    animation: map-pulse 3.4s var(--ease-out) infinite;
  }

  .visual-foot {
    justify-content: flex-start;
    border-top: 1px solid var(--line-subtle);
  }

  .visual-foot i {
    width: 5px;
    height: 5px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--accent);
  }

  @keyframes map-pulse {
    0% { opacity: 0.35; transform: scale(0.72); }
    100% { opacity: 0; transform: scale(1.5); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse { display: none; }
  }
</style>
