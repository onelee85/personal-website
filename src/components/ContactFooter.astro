---
import { contact, identity, ui } from '../data/site';
const marquee = contact.marquee;
---

<section class="section container contact" aria-labelledby="contact">
  <div class="contact-marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>{marquee.repeat(3)}</span>
      <span>{marquee.repeat(3)}</span>
    </div>
  </div>

  <div class="contact-grid">
    <div>
      <span class="eyebrow">{contact.eyebrow}</span>
      <h2 id="contact" class="reveal">{contact.headline}</h2>
    </div>

    <div class="contact-panel reveal glare-hover">
      <div class="contact-panel-meta">
        <span>{contact.panelLabel}</span>
        <i aria-hidden="true"></i>
      </div>
      <strong>{contact.panelTitle}</strong>
      <p>{contact.note}</p>
      <a class="resume-link" href="/resume/">查看 / 保存职业简历 <span aria-hidden="true">↗</span></a>
      <ul class="contact-channels" aria-label={contact.channelsAria}>
        {contact.channels.map((channel) => (
          <li>
            <span class="contact-channel-label">{channel.label}</span>
            {channel.href ? (
              <a
                href={channel.href}
                target={channel.external ? '_blank' : undefined}
                rel={channel.external ? 'noopener noreferrer' : undefined}
              >{channel.value}</a>
            ) : (
              <span class="contact-channel-value">{channel.value}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="contact-meta">
    <span>{identity.roleZh}</span>
    <span>{ui.hero.basedInLabel} {identity.basedIn}</span>
  </div>
</section>

<style>
  .contact-marquee {
    overflow: hidden;
    margin-bottom: clamp(24px, 3vw, 40px);
    padding-block: 12px;
    border-block: 1px solid var(--line-subtle);
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee-track span {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    align-items: start;
    gap: clamp(24px, 4vw, 64px);
  }

  .contact h2 {
    max-width: 14em;
    margin-top: var(--space-3);
    font-family: var(--font-serif-cn);
    font-size: clamp(32px, 4vw, 60px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .contact-panel {
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, var(--accent-soft), transparent 46%), var(--surface-1);
  }

  .contact-panel-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .contact-panel-meta i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-tertiary);
  }

  .contact-panel > strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-primary);
    font-family: var(--font-serif-cn);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 900;
    line-height: 1.2;
  }

  .contact-panel > p {
    margin-top: 12px;
    color: var(--text-secondary);
    font-size: 13px;
  }

  .resume-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
  }

  .resume-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact-channels {
    display: grid;
    gap: 12px;
    margin: 24px 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-subtle);
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .contact-channels li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
  }

  .contact-channel-label {
    color: var(--text-tertiary);
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .contact-channels a,
  .contact-channel-value {
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .contact-channels a:hover {
    color: var(--accent);
  }

  .contact-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 64px;
    padding-top: 18px;
    border-top: 1px solid var(--line-subtle);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-panel {
      max-width: 560px;
    }
  }

  @media (max-width: 639px) {
    .contact-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
