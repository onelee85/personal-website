---
import { contact, identity } from '../data/site';
const marquee = contact.marquee;
---

<section class="section container contact" aria-labelledby="contact">
  <div class="contact-marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>{marquee.repeat(3)}</span>
      <span>{marquee.repeat(3)}</span>
    </div>
  </div>

  <div class="contact-grid">
    <div>
      <span class="eyebrow">{contact.eyebrow}</span>
      <h2 id="contact" class="reveal">{contact.headline}</h2>
    </div>

    <div class="contact-panel reveal glare-hover">
      <div class="contact-panel-meta">
        <span>{contact.panelLabel}</span>
        <i aria-hidden="true"></i>
      </div>
      <strong>{contact.placeholderTitle}</strong>
      <p>{contact.note}</p>
      <div class="contact-placeholders" aria-label={contact.placeholderAria}>
        <span>{contact.emailPlaceholder}</span>
        <span>{contact.githubPlaceholder}</span>
      </div>
      <a href="#work">{contact.projectLink} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </div>

  <div class="contact-meta">
    <span>{identity.roleZh}</span>
    <span>Based in {identity.basedIn}</span>
  </div>
</section>

<style>
  .contact {
    padding-top: clamp(80px, 12vw, 176px);
  }

  .contact-marquee {
    overflow: hidden;
    margin-bottom: clamp(56px, 8vw, 112px);
    padding-block: 12px;
    border-block: 1px solid var(--line-subtle);
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee-track span {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    align-items: end;
    gap: clamp(40px, 7vw, 100px);
  }

  .contact h2 {
    max-width: 17ch;
    margin-top: 22px;
    font-family: var(--font-serif-cn);
    font-size: clamp(38px, 5.4vw, 78px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .contact-panel {
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, var(--accent-soft), transparent 46%), var(--surface-1);
  }

  .contact-panel-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .contact-panel-meta i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-tertiary);
  }

  .contact-panel > strong {
    display: block;
    margin-top: 36px;
    color: var(--text-primary);
    font-family: var(--font-serif-cn);
    font-size: clamp(38px, 4vw, 56px);
    font-weight: 900;
  }

  .contact-panel > p {
    margin-top: 12px;
    color: var(--text-secondary);
    font-size: 13px;
  }

  .contact-placeholders {
    display: grid;
    gap: 8px;
    margin-top: 24px;
    padding-block: 16px;
    border-block: 1px solid var(--line-subtle);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .contact-panel > a {
    display: inline-flex;
    gap: 8px;
    margin-top: 24px;
    color: var(--accent);
    font-size: 13px;
  }

  .contact-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 64px;
    padding-top: 18px;
    border-top: 1px solid var(--line-subtle);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-panel {
      max-width: 560px;
    }
  }

  @media (max-width: 639px) {
    .contact-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
