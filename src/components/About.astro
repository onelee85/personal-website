---
import SectionHeading from './SectionHeading.astro';
import { principles, sections, skillGroups, targetRoles, ui } from '../data/site';
---

<section class="section container about" aria-labelledby="about">
  <SectionHeading id="about" {...sections.about} />

  <p class="about-statement reveal">
    {ui.about.statementBefore}<br />{ui.about.statementBridge}<span>{ui.about.statementAccent}</span>{ui.about.statementAfter}
  </p>

  <div class="principles">
    {principles.map((principle, index) => (
      <article class="principle reveal glare-hover" style={`--reveal-i:${index}`}>
        <span>{principle.index}</span>
        <h3>{principle.title}</h3>
        <p>{principle.text}</p>
      </article>
    ))}
  </div>

  <div class="skills-layout">
    <div class="skills-intro reveal">
      <span class="eyebrow">{ui.about.skillsEyebrow}</span>
      <h3>{ui.about.skillsTitleLines[0]}<br />{ui.about.skillsTitleLines[1]}</h3>
      <p>{ui.about.skillsDescription}</p>
      <div class="role-list" aria-label={ui.a11y.targetRoles}>
        {targetRoles.map((role) => <span>{role}</span>)}
      </div>
    </div>

    <div class="skill-groups reveal" style="--reveal-i:1">
      {skillGroups.map((group) => (
        <section class="skill-group">
          <h4>{group.label}</h4>
          <ul class="tag-list" role="list">
            {group.items.map((item) => <li class="tag">{item}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .about-statement {
    max-width: 18ch;
    color: var(--text-primary);
    font-family: var(--font-serif-cn);
    font-size: clamp(34px, 5.2vw, 72px);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1.25;
  }

  .about-statement span {
    color: var(--accent);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(36px, 5vw, 64px);
  }

  .principle {
    min-height: 0;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    padding: clamp(20px, 2.5vw, 32px);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-lg);
    background: var(--layer-1);
    transition: border-color var(--dur-hover) var(--ease-out), transform var(--dur-hover) var(--ease-out);
  }

  .principle:hover {
    border-color: var(--accent-border);
    transform: translateY(-3px);
  }

  .principle > span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .principle h3 {
    margin-top: 28px;
    font-family: var(--font-serif-cn);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 700;
  }

  .principle p {
    margin-top: 14px;
    color: var(--text-secondary);
    font-size: 13px;
  }

  .skills-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 8vw, 120px);
    margin-top: clamp(56px, 6vw, 88px);
    padding-top: 24px;
    border-top: 1px solid var(--line-subtle);
  }

  .skills-intro h3 {
    margin-top: 16px;
    font-family: var(--font-serif-cn);
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.3;
  }

  .skills-intro p {
    max-width: 44ch;
    margin-top: 20px;
    color: var(--text-secondary);
    font-size: 14px;
  }

  .role-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 24px;
  }

  .role-list span {
    color: var(--text-primary);
    font-size: 12px;
  }

  .role-list span::before {
    content: '↳';
    margin-right: 6px;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .skill-groups {
    display: grid;
    gap: 0;
  }

  .skill-group {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line-subtle);
  }

  .skill-group:first-child {
    padding-top: 0;
  }

  .skill-group h4 {
    padding-top: 5px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 450;
    letter-spacing: 0.09em;
  }

  @media (max-width: 900px) {
    .principles {
      grid-template-columns: 1fr;
    }

    .principle {
      min-height: 0;
    }

    .principle h3 {
      margin-top: 20px;
    }

    .skills-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .skill-group {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
