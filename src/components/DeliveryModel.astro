---
import SectionHeading from './SectionHeading.astro';
import { aiTracks, futureDirections, lifecycle, sections } from '../data/site';
---

<section class="section container delivery-model" aria-labelledby="model">
  <SectionHeading id="model" {...sections.model} />

  <div class="track-grid">
    {aiTracks.map((track, index) => (
      <article class="track-card reveal" style={`--reveal-i:${index}`}>
        <div class="track-meta">
          <span>{track.code}</span>
          <strong>{track.status}</strong>
        </div>
        <h3>{track.title}</h3>
        <p>{track.description}</p>
      </article>
    ))}
  </div>

  <div class="lifecycle reveal">
    <div class="lifecycle-heading">
      <span class="eyebrow">Full-lifecycle delivery</span>
      <p>AI 协同、质量、安全与可观测性贯穿全流程。</p>
    </div>
    <ol class="lifecycle-list" role="list">
      {lifecycle.map((phase) => (
        <li>
          <span>{phase.index}</span>
          <strong>{phase.label}</strong>
          <small>{phase.english}</small>
        </li>
      ))}
    </ol>
  </div>

  <div class="future-line reveal">
    <span>长期方向</span>
    <ul role="list">
      {futureDirections.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .track-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .track-card {
    min-height: 260px;
    padding: clamp(22px, 3vw, 36px);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, var(--layer-2), transparent), var(--surface-1);
  }

  .track-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .track-meta strong {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
    text-align: right;
  }

  .track-card h3 {
    margin-top: clamp(36px, 5vw, 64px);
    font-family: var(--font-serif-cn);
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .track-card p {
    max-width: 54ch;
    margin-top: 18px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.85;
  }

  .lifecycle {
    margin-top: 16px;
    padding: clamp(22px, 3vw, 36px);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-lg);
    background: var(--layer-1);
  }

  .lifecycle-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line-subtle);
  }

  .lifecycle-heading p {
    color: var(--text-secondary);
    font-size: 12px;
  }

  .lifecycle-list {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    margin-top: 24px;
  }

  .lifecycle-list li {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 96px;
    flex-direction: column;
    gap: 7px;
    padding: 0 14px;
    border-left: 1px solid var(--line-subtle);
  }

  .lifecycle-list li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .lifecycle-list span,
  .lifecycle-list small {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .lifecycle-list strong {
    margin-top: auto;
    font-size: 14px;
    font-weight: 550;
  }

  .lifecycle-list small {
    overflow-wrap: anywhere;
  }

  .future-line {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-top: 24px;
    padding-inline: 4px;
  }

  .future-line > span {
    flex: 0 0 auto;
    padding-top: 5px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .future-line ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .future-line li {
    padding: 5px 9px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 11px;
  }

  @media (max-width: 1050px) {
    .lifecycle-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px 0;
    }

    .lifecycle-list li:nth-child(5) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 760px) {
    .track-grid {
      grid-template-columns: 1fr;
    }

    .track-card {
      min-height: 0;
    }

    .track-card h3 {
      margin-top: 36px;
    }

    .lifecycle-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }

  @media (max-width: 520px) {
    .track-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .track-meta strong {
      text-align: left;
    }

    .lifecycle-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lifecycle-list li,
    .lifecycle-list li:nth-child(5) {
      padding-left: 14px;
      border-left: 1px solid var(--line-subtle);
    }

    .lifecycle-list li:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .future-line {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
