---
import SectionHeading from './SectionHeading.astro';
import { capabilities, sections } from '../data/site';
---

<section class="section container capabilities" aria-labelledby="focus">
  <SectionHeading id="focus" {...sections.focus} />

  <ul class="capability-grid" role="list">
    {capabilities.map((item, index) => (
      <li id={`focus-${item.id}`} class="capability-item reveal" style={`--reveal-i:${index % 4}`}>
        <article class="capability-card">
          <div class="capability-meta">
            <span>{item.index}</span>
            <strong class:list={[`status--${item.tone}`]}>{item.status}</strong>
          </div>
          <div class="capability-title">
            <h3>{item.title}</h3>
            <span>{item.english}</span>
          </div>
          <p>{item.blurb}</p>
          <div class="capability-evidence">
            <span>{item.evidenceLabel}</span>
            <ul role="list">
              {item.evidence.map((project) => (
                <li><a href={project.href}>{project.label}<span aria-hidden="true"> ↗</span></a></li>
              ))}
            </ul>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .capability-item {
    min-width: 0;
    scroll-margin-top: 108px;
  }

  .capability-card {
    display: flex;
    min-height: 236px;
    height: 100%;
    flex-direction: column;
    padding: clamp(18px, 2vw, 24px);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-lg);
    background: var(--layer-1);
    transition: border-color var(--dur-hover) var(--ease-out), background var(--dur-hover) var(--ease-out);
  }

  .capability-card:hover {
    border-color: var(--accent-border);
    background: var(--surface-1);
  }

  .capability-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .capability-meta > span {
    color: var(--accent);
  }

  .capability-meta strong {
    padding: 4px 8px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
  }

  .status--proven {
    color: var(--accent);
  }

  .status--building {
    color: var(--text-secondary);
  }

  .capability-title {
    margin-top: 20px;
  }

  .capability-title h3 {
    font-family: var(--font-serif-cn);
    font-size: clamp(23px, 2.2vw, 30px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .capability-title > span {
    display: block;
    margin-top: 6px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
  }

  .capability-card > p {
    margin-top: 12px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.7;
  }

  .capability-evidence {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line-subtle);
  }

  .capability-evidence > span {
    padding-top: 11px;
    color: var(--text-tertiary);
    font-size: 11px;
    white-space: nowrap;
  }

  .capability-evidence ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 12px;
  }

  .capability-evidence a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--text-primary);
    font-size: 12px;
  }

  .capability-evidence a:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .capability-grid {
      grid-template-columns: 1fr;
    }

    .capability-card {
      min-height: 0;
    }

    .capability-evidence {
      margin-top: 20px;
    }
  }

  @media (max-width: 420px) {
    .capability-evidence {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .capability-evidence > span {
      padding-top: 0;
    }

    .capability-evidence ul {
      justify-content: flex-start;
    }
  }
</style>
