---
import { identity, nav, ui } from '../data/site';
const prefix = Astro.url.pathname === '/' ? '' : '/';
---

<header class="site-nav" data-nav>
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${identity.name} ${ui.a11y.homeSuffix}`}>
      <span class="brand-mark">{identity.mark}</span>
      <span class="brand-dot" aria-hidden="true"></span>
    </a>

    <div class="nav-right">
      <nav class="nav-links" aria-label={ui.a11y.primaryNav}>
        {nav.map((item) => <a href={`${prefix}${item.href}`} class="nav-link glare-hover">{item.label}</a>)}
      </nav>
      <span class="nav-status"><i aria-hidden="true"></i>{ui.nav.locationCode}</span>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-label={ui.nav.menu}
        data-close-label={ui.nav.close}
      >{ui.nav.menu}</button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label={ui.a11y.mobileNav}>
      {nav.map((item, index) => (
        <a href={`${prefix}${item.href}`} class="mobile-link">
          <span>0{index + 1}</span>{item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 72px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition: background var(--dur-hover) var(--ease-out), border-color var(--dur-hover) var(--ease-out);
  }

  .site-nav.is-scrolled {
    border-bottom-color: var(--line-subtle);
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
  }

  .nav-inner,
  .nav-right,
  .nav-links,
  .brand,
  .nav-status {
    display: flex;
    align-items: center;
  }

  .nav-inner {
    justify-content: space-between;
    gap: var(--space-6);
  }

  .brand {
    gap: 10px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .brand-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
  }

  .nav-right {
    gap: var(--space-6);
  }

  .nav-links {
    gap: var(--space-6);
  }

  .nav-link {
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 13px;
    letter-spacing: 0.04em;
    transition: color var(--dur-hover) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-status {
    gap: 7px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .nav-status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .nav-toggle {
    display: none;
    min-width: 48px;
    min-height: 44px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .mobile-menu {
    position: fixed;
    inset: 60px 0 0;
    z-index: 49;
    padding: 24px var(--content-pad);
    background: var(--canvas);
  }

  .mobile-menu:not([hidden]) {
    display: block;
  }

  .mobile-link {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line-subtle);
    font-family: var(--font-display);
    font-size: clamp(30px, 8vw, 42px);
    font-weight: 650;
  }

  .mobile-link span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
  }

  @media (max-width: 820px) {
    .site-nav {
      height: 60px;
    }

    .nav-links,
    .nav-status {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
    }
  }
</style>

<script>
  const navElement = document.querySelector<HTMLElement>('[data-nav]');
  const updateNav = () => {
    navElement?.classList.toggle('is-scrolled', window.scrollY > 32);
  };
  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();

  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    if (toggle) toggle.textContent = toggle.dataset.menuLabel ?? '';
    if (menu) menu.hidden = true;
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMenu();
      return;
    }
    toggle.setAttribute('aria-expanded', 'true');
    toggle.textContent = toggle.dataset.closeLabel ?? '';
    if (menu) menu.hidden = false;
    document.body.style.overflow = 'hidden';
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  window.addEventListener('resize', () => {
    if (window.innerWidth > 820) closeMenu();
  });
</script>
