---
import { getCollection } from 'astro:content';
import { identity, hero, ui } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section class="hero" id="hero" aria-label={ui.a11y.personalIntro}>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="hero-id">
        <span class="hero-role">{identity.roleTag}</span>
        <span class="hero-status"><i aria-hidden="true"></i>{identity.status}</span>
      </div>

      <h1 class="hero-thesis">
        {hero.thesis.map((line, index) => (
          <span class="thesis-line">
            {line}{index === hero.thesis.length - 1 && <em aria-hidden="true"></em>}
          </span>
        ))}
      </h1>

      <p class="hero-lead">{hero.lead}</p>

      <div class="hero-actions">
        <a class="btn" href="#work">{ui.actions.viewProjects} <span aria-hidden="true">↓</span></a>
        <a class="btn btn--ghost" href="#journey">{ui.actions.viewJourney}</a>
      </div>

      <div class="hero-proof" aria-label={ui.a11y.careerOverview}>
        {ui.hero.proofs.map((proof) => (
          <span class="glare-hover"><b>{proof.value}</b> {proof.label}</span>
        ))}
      </div>

      <nav class="hero-projects" aria-label={ui.a11y.projectIndex}>
        {projects.map((project, index) => (
          <span class="project-pair">
            {index > 0 && <span class="project-arrow" aria-hidden="true">→</span>}
            <a href={`#work-${project.id}`} class="glare-hover">
              <span>0{project.data.order}</span>{project.data.title}
            </a>
          </span>
        ))}
      </nav>

      <div class="hero-meta">
        <span>{identity.roleEn}</span>
        <i aria-hidden="true">/</i>
        <span>{ui.hero.basedInLabel} {identity.basedIn}</span>
        <i aria-hidden="true">/</i>
        <span>{ui.hero.sinceLabel} {identity.startYear}</span>
      </div>
    </div>

    <aside class="system-card" aria-label={ui.a11y.workDirection}>
      <div class="system-top">
        <span>{ui.hero.systemCard.eyebrow}</span>
        <span>{ui.hero.systemCard.version}</span>
      </div>
      <div class="system-core">
        <span class="core-ring" aria-hidden="true"></span>
        <strong>{ui.hero.systemCard.coreTitle}</strong>
        <small>{ui.hero.systemCard.coreSubtitle}</small>
      </div>
      <ol class="system-layers" role="list">
        {ui.hero.systemCard.layers.map((layer) => (
          <li><span>{layer.index}</span><b>{layer.code}</b><em>{layer.label}</em></li>
        ))}
      </ol>
      <div class="system-foot"><i aria-hidden="true"></i>{ui.hero.systemCard.footer}</div>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 96px 40px;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.28;
    background-image: linear-gradient(var(--line-subtle) 1px, transparent 1px), linear-gradient(90deg, var(--line-subtle) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 86%);
  }

  .hero-glow {
    position: absolute;
    inset: -20% -10% auto 30%;
    height: 80%;
    pointer-events: none;
    background: var(--hero-glow);
    filter: blur(30px);
    animation: glow-drift 12s var(--ease-out) infinite alternate;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(270px, 0.34fr);
    align-items: end;
    gap: clamp(36px, 5vw, 76px);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-id {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: clamp(20px, 2.5vw, 32px);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-subtle);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .hero-role {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-tertiary);
  }

  .hero-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .hero-thesis {
    display: flex;
    flex-direction: column;
    color: var(--text-primary);
    font-family: var(--font-serif-cn);
    font-size: var(--fs-thesis);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.16;
  }

  .thesis-line {
    display: block;
  }

  .js .thesis-line {
    opacity: 0;
    transform: translateY(0.3em);
    animation: thesis-rise 760ms var(--ease-out) forwards;
  }

  .js .thesis-line:nth-child(2) {
    animation-delay: 100ms;
  }

  .thesis-line em {
    display: inline-block;
    width: 0.22em;
    height: 0.22em;
    margin-left: 0.16em;
    background: var(--accent);
    vertical-align: 0.08em;
  }

  .hero-lead {
    max-width: 52ch;
    margin-top: clamp(18px, 2vw, 28px);
    color: var(--text-secondary);
    font-size: var(--fs-lead);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .hero-proof span {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-tertiary);
    font-size: 11px;
  }

  .hero-proof b {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 450;
  }

  .hero-projects {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
    padding-top: 14px;
    border-top: 1px solid var(--line-subtle);
  }

  .project-pair,
  .project-pair a {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
  }

  .project-pair a {
    padding: 4px 5px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    transition: color var(--dur-hover) var(--ease-out);
  }

  .project-pair a span,
  .project-arrow {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .project-pair a:hover,
  .project-pair a:hover span {
    color: var(--accent);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .hero-meta i {
    font-style: normal;
    opacity: 0.5;
  }

  .system-card {
    position: relative;
    padding: 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, var(--layer-2), transparent), var(--surface-1);
    box-shadow: var(--card-shadow);
  }

  .system-top,
  .system-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .system-core {
    position: relative;
    min-height: 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    margin-block: 18px;
    border-block: 1px solid var(--line-subtle);
    overflow: hidden;
  }

  .core-ring {
    position: absolute;
    width: 160px;
    height: 160px;
    border: 1px solid var(--accent-border);
    border-radius: 50%;
    box-shadow: var(--core-ring-shadow);
    animation: core-pulse 4s var(--ease-out) infinite alternate;
  }

  .system-core strong,
  .system-core small {
    position: relative;
  }

  .system-core strong {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 16px;
    letter-spacing: 0.08em;
  }

  .system-core small {
    color: var(--text-secondary);
    font-size: 11px;
  }

  .system-layers {
    display: grid;
    gap: 8px;
    margin-bottom: 18px;
  }

  .system-layers li {
    display: grid;
    grid-template-columns: 26px 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 10px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    background: var(--layer-1);
  }

  .system-layers span,
  .system-layers b {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  .system-layers span {
    color: var(--accent);
  }

  .system-layers b {
    font-weight: 450;
  }

  .system-layers em {
    color: var(--text-tertiary);
    font-size: 10px;
    font-style: normal;
  }

  .system-foot {
    justify-content: flex-start;
  }

  .system-foot i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  @keyframes thesis-rise {
    to { opacity: 1; transform: none; }
  }

  @keyframes glow-drift {
    to { transform: translate3d(-4%, 4%, 0) scale(1.05); opacity: 0.7; }
  }

  @keyframes core-pulse {
    to { transform: scale(1.04); opacity: 0.65; }
  }

  @media (max-width: 1100px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .system-card {
      display: none;
    }

    .hero-copy {
      max-width: 980px;
    }
  }

  @media (max-width: 639px) {
    .hero {
      min-height: auto;
      padding-block: 88px 40px;
    }

    .hero-id {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .hero-thesis {
      letter-spacing: -0.03em;
    }

    .hero-lead {
      font-size: 16px;
    }

    .hero-proof {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-proof span {
      justify-content: space-between;
    }

    .project-arrow {
      display: none;
    }

    .project-pair {
      width: calc(50% - 5px);
    }

    .project-pair a {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .thesis-line {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
