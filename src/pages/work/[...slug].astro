---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getFeaturedProjects } from '../../lib/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { ui } from '../../data/site';

interface Props {
  project: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = await getFeaturedProjects();
const currentIndex = projects.findIndex((item) => item.id === project.id);
const nextProject = projects[(currentIndex + 1) % projects.length];
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="case-page">
    <header class="container case-hero">
      <a class="back-link" href="/#work"><span aria-hidden="true">←</span> {ui.actions.backToWork}</a>
      <div class="case-kicker">
        <span>{ui.case.studyLabel}{project.data.featured && ` / 0${project.data.order}`}</span>
        <span>{project.data.status}</span>
      </div>
      <h1>{project.data.title}</h1>
      <p>{project.data.tagline}</p>
      <dl class="case-meta">
        {project.data.period && <div><dt>{ui.case.period}</dt><dd>{project.data.period}</dd></div>}
        {project.data.role && <div><dt>{ui.case.role}</dt><dd>{project.data.role}</dd></div>}
        <div><dt>{ui.case.domain}</dt><dd>{project.data.domain}</dd></div>
      </dl>
    </header>

    {project.data.theme && <div class="container case-visual reveal">
      <ProjectVisual theme={project.data.theme} />
    </div>}

    <div class="container case-layout" class:list={[{ 'case-layout--single': !project.data.stack.length }]}>
      {project.data.stack.length > 0 && <aside class="case-sidebar reveal">
        <span class="eyebrow">{ui.case.systemContext}</span>
        <h2>{ui.case.specsTitle}</h2>
        <ul class="tag-list" role="list" aria-label={ui.a11y.technologyPractice}>
          {project.data.stack.map((item) => <li class="tag">{item}</li>)}
        </ul>
        <p>{ui.case.evidenceNote}</p>
      </aside>}

      <div class="case-content">
        {project.data.facts.length > 0 && (
          <section class="case-facts reveal" aria-labelledby="facts-title">
            <div class="case-section-meta">
              <span class="eyebrow">{ui.case.factsEyebrow}</span>
              <span>{ui.case.factsIndex}</span>
            </div>
            <h2 id="facts-title">{ui.case.factsTitle}</h2>
            <div class="fact-grid">
              {project.data.facts.map((fact) => (
                <div class="fact-card">
                  <strong>{fact.value}</strong>
                  <h3>{fact.label}</h3>
                  {fact.note && <p>{fact.note}</p>}
                </div>
              ))}
            </div>
          </section>
        )}

        {project.data.decisions.length > 0 && (
          <section class="case-decisions reveal" aria-labelledby="decisions-title">
            <div class="case-section-meta">
              <span class="eyebrow">{ui.case.decisionsEyebrow}</span>
              <span>{ui.case.decisionsIndex}</span>
            </div>
            <h2 id="decisions-title">{ui.case.decisionsTitle}</h2>
            <ol role="list">
              {project.data.decisions.map((decision, index) => (
                <li>
                  <span>0{index + 1}</span>
                  <div><h3>{decision.title}</h3><p>{decision.description}</p></div>
                </li>
              ))}
            </ol>
          </section>
        )}

        <section class="case-prose reveal" aria-label={ui.a11y.caseDetails}>
          <Content />
        </section>
      </div>
    </div>

    <nav class="container case-bottom" aria-label={ui.a11y.caseNavigation}>
      <a href="/#work"><span aria-hidden="true">←</span> {ui.actions.allProjects}</a>
      <a href={`/work/${nextProject.id}/`}>
        <span><small>{ui.labels.nextCase}</small>{nextProject.data.title}</span><span aria-hidden="true">↗</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .case-hero {
    padding-top: clamp(140px, 16vw, 220px);
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  .back-link {
    display: inline-flex;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 12px;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .case-kicker {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: clamp(48px, 8vw, 96px);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-subtle);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .case-kicker span:last-child {
    color: var(--accent);
  }

  .case-hero h1 {
    max-width: 14ch;
    margin-top: 28px;
    font-family: var(--font-serif-cn);
    font-size: var(--fs-display);
    font-weight: 900;
    letter-spacing: -0.05em;
  }

  .case-hero > p {
    max-width: 48ch;
    margin-top: 24px;
    color: var(--text-secondary);
    font-size: var(--fs-lead);
  }

  .case-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 48px;
  }

  .case-meta > div {
    padding-top: 14px;
    border-top: 1px solid var(--line-subtle);
  }

  .case-meta dt {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .case-meta dd {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 13px;
  }

  .case-visual :global(.project-visual) {
    max-width: 1180px;
    margin-inline: auto;
  }

  .case-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.3fr) minmax(0, 1fr);
    gap: clamp(40px, 8vw, 120px);
    padding-top: clamp(72px, 10vw, 144px);
    padding-bottom: var(--section-gap);
  }

  .case-layout--single {
    grid-template-columns: minmax(0, 72ch);
  }

  .case-sidebar {
    position: sticky;
    top: 108px;
    align-self: start;
  }

  .case-sidebar h2 {
    margin-top: 12px;
    font-family: var(--font-serif-cn);
    font-size: 30px;
    font-weight: 900;
  }

  .case-sidebar .tag-list {
    margin-top: 24px;
  }

  .case-sidebar > p {
    margin-top: 24px;
    color: var(--text-tertiary);
    font-size: 12px;
  }

  .case-content {
    min-width: 0;
  }

  .case-content section + section {
    margin-top: clamp(72px, 9vw, 120px);
  }

  .case-section-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-subtle);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .case-section-meta .eyebrow {
    color: var(--accent);
  }

  .case-content section > h2 {
    margin-top: 24px;
    font-family: var(--font-serif-cn);
    font-size: clamp(30px, 3.5vw, 46px);
    font-weight: 900;
  }

  .fact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .fact-card {
    padding: 22px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--layer-1);
  }

  .fact-card > strong {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 300;
    letter-spacing: -0.04em;
  }

  .fact-card h3 {
    margin-top: 12px;
    font-size: 15px;
    font-weight: 550;
  }

  .fact-card p {
    margin-top: 10px;
    color: var(--text-tertiary);
    font-size: 12px;
  }

  .case-decisions ol {
    margin-top: 24px;
  }

  .case-decisions li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 18px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line-subtle);
  }

  .case-decisions li > span {
    padding-top: 4px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .case-decisions h3 {
    font-size: 19px;
    font-weight: 600;
  }

  .case-decisions p {
    margin-top: 10px;
    color: var(--text-secondary);
    font-size: 14px;
  }

  .case-prose :global(h2) {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line-subtle);
    font-family: var(--font-serif-cn);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 900;
  }

  .case-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .case-prose :global(p),
  .case-prose :global(li) {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.95;
  }

  .case-prose :global(p) {
    margin-top: 18px;
  }

  .case-prose :global(ul) {
    display: grid;
    gap: 12px;
    margin-top: 20px;
    padding-left: 20px;
  }

  .case-prose :global(li)::marker {
    color: var(--accent);
  }

  .case-prose :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .case-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: var(--section-gap);
    padding-top: 28px;
    border-top: 1px solid var(--line-subtle);
  }

  .case-bottom > a {
    color: var(--text-secondary);
    font-size: 13px;
  }

  .case-bottom > a:last-child {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--text-primary);
    text-align: right;
  }

  .case-bottom > a:last-child > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .case-bottom small {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .case-bottom a:hover {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .case-layout {
      grid-template-columns: 1fr;
    }

    .case-sidebar {
      position: static;
    }
  }

  @media (max-width: 639px) {
    .case-kicker {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .case-meta,
    .fact-grid {
      grid-template-columns: 1fr;
    }

    .case-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .case-bottom > a:last-child {
      width: 100%;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
