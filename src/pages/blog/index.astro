---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const timestamp = (date: string) => new Date(date.replace(' ', 'T')).getTime();
const posts = (await getCollection('blog')).sort((a, b) => timestamp(b.data.date) - timestamp(a.data.date));
const featuredIds = ['engineering-productivity', 'troubleshooting', 'redis-replication-incident'];
const featuredPosts = featuredIds
  .map((id) => posts.find((post) => post.id === id))
  .filter((post): post is CollectionEntry<'blog'> => Boolean(post));
const byName = new Intl.Collator('zh-CN', { numeric: true });
const groups = new Map<string, CollectionEntry<'blog'>[]>();
for (const post of posts) {
  const category = post.data.categories[0] ?? '未分类';
  const group = groups.get(category);
  if (group) {
    group.push(post);
  } else {
    groups.set(category, [post]);
  }
}
const categoryGroups = [...groups]
  .map(([label, categoryPosts]) => ({ label, posts: categoryPosts }))
  .sort((a, b) => b.posts.length - a.posts.length || byName.compare(a.label, b.label));
const formatDate = (date: string) => date.slice(0, 10);
const getExcerpt = (post: CollectionEntry<'blog'>) => (post.body ?? '')
  .split('<!-- more -->')[0]
  .replace(/[#>*_`\[\]]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
---

<BaseLayout title="Blog" description="李皎的技术博客，记录后端开发、线上故障排查、直播技术和研发团队管理实践。">
  <div class="container archive">
    <header class="archive-header">
      <div class="archive-intro">
        <span class="eyebrow">Engineering notes / Archive</span>
        <h1>Blog<span aria-hidden="true">.</span></h1>
        <p>技术实践、研发管理与个人思考。三篇精选用于快速了解工程方法，全部 {posts.length} 篇文章均在下方按分类完整保留。</p>
      </div>
      <nav class="archive-overview" aria-label="博客内容导航">
        <a href="#featured">
          <span class="overview-number">03</span>
          <span class="overview-copy">
            <strong>精选三篇</strong>
            <small>快速了解工程方法</small>
          </span>
          <span class="overview-arrow" aria-hidden="true">↓</span>
        </a>
        <a href="#categories">
          <span class="overview-number">{posts.length}</span>
          <span class="overview-copy">
            <strong>按分类浏览</strong>
            <small>全部文章保留并展示</small>
          </span>
          <span class="overview-arrow" aria-hidden="true">↓</span>
        </a>
      </nav>
    </header>

    <section id="featured" class="featured" aria-labelledby="featured-title">
      <div class="section-heading">
        <h2 id="featured-title">精选三篇</h2>
        <p>从研发管理、故障排查与线上复盘，快速了解我的工程方法。</p>
      </div>
      <div class="featured-grid">
        {featuredPosts.map((post, index) => (
          <article class="featured-card">
            <span class="featured-number">{String(index + 1).padStart(2, '0')}</span>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{getExcerpt(post)}</p>
            <footer>
              <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
              <a href={`/blog/${post.id}/`} aria-label={`阅读${post.data.title}`}>阅读文章 <span aria-hidden="true">↗</span></a>
            </footer>
          </article>
        ))}
      </div>
    </section>

    <section id="categories" class="all-posts" aria-labelledby="categories-title">
      <div class="section-heading">
        <h2 id="categories-title">按分类浏览</h2>
        <p>{posts.length} 篇全部保留（含精选） · {categoryGroups.length} 个分类 · 组内按日期倒序</p>
      </div>
      <nav class="category-nav" aria-label="文章分类">
        {categoryGroups.map((group, index) => (
          <a href={`#category-${index}`}>{group.label}<span>{group.posts.length}</span></a>
        ))}
      </nav>
      <div class="category-groups">
        {categoryGroups.map((group, index) => (
          <section id={`category-${index}`} class="category-group" aria-labelledby={`category-title-${index}`}>
            <header class="category-heading">
              <h3 id={`category-title-${index}`}>{group.label}</h3>
              <span>{group.posts.length} 篇</span>
            </header>
            <ol class="post-list" role="list">
              {group.posts.map((post) => (
                <li>
                  <article class="post-row">
                    <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                    <h4><a href={`/blog/${post.id}/`}>{post.data.title}</a></h4>
                    <ul class="post-tags" aria-label={`${post.data.title}标签`}>
                      {post.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
                    </ul>
                  </article>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .archive {
    max-width: 1180px;
    padding-block: clamp(116px, 13vw, 164px) var(--section-gap);
  }

  .archive-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 0.9fr);
    align-items: end;
    gap: clamp(36px, 6vw, 80px);
    padding-bottom: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--line-strong);
  }

  .archive-header h1 {
    margin-top: 16px;
    font-size: var(--fs-display);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .archive-header h1 span {
    color: var(--accent);
  }

  .archive-header p {
    max-width: 58ch;
    margin-top: 20px;
    color: var(--text-secondary);
    font-size: var(--fs-lead);
    line-height: 1.8;
  }

  .archive-overview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .archive-overview > a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    min-height: 132px;
    padding: 20px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--layer-1);
    transition: border-color var(--dur-hover) var(--ease-out), background var(--dur-hover) var(--ease-out);
  }

  .archive-overview > a:hover {
    border-color: var(--accent-border);
    background: var(--surface-1);
  }

  .overview-number {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: clamp(32px, 3.5vw, 46px);
    line-height: 1;
  }

  .overview-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 8px;
  }

  .overview-copy strong {
    font-size: 15px;
    font-weight: 650;
  }

  .overview-copy small {
    color: var(--text-secondary);
    font-size: 11px;
    line-height: 1.5;
  }

  .overview-arrow {
    grid-column: 1 / -1;
    justify-self: end;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .featured,
  .all-posts {
    margin-top: clamp(44px, 7vw, 80px);
    scroll-margin-top: 96px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .section-heading h2 {
    font-family: var(--font-serif-cn);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 800;
  }

  .section-heading p {
    color: var(--text-tertiary);
    font-size: 12px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .featured-card {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.5vw, 28px);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-lg);
    background: var(--layer-1);
    transition: border-color var(--dur-hover) var(--ease-out), transform var(--dur-hover) var(--ease-out);
  }

  .featured-card:hover {
    border-color: var(--accent-border);
    transform: translateY(-3px);
  }

  .featured-number {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .featured-card h3 {
    margin-top: 40px;
    font-family: var(--font-serif-cn);
    font-size: clamp(22px, 2.3vw, 30px);
    font-weight: 750;
    line-height: 1.35;
  }

  .featured-card h3 a:hover,
  .post-row h4 a:hover {
    color: var(--accent);
  }

  .featured-card > p {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 16px;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.75;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .featured-card footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 24px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .featured-card footer a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 12px;
  }

  .featured-card footer a:hover {
    color: var(--accent);
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .category-nav a {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    gap: 8px;
    padding: 6px 11px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 12px;
  }

  .category-nav a:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .category-nav span {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .category-group {
    scroll-margin-top: 96px;
  }

  .category-group + .category-group {
    margin-top: clamp(36px, 5vw, 52px);
  }

  .category-heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }

  .category-heading h3 {
    font-family: var(--font-serif-cn);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 750;
  }

  .category-heading > span {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .post-list {
    border-top: 1px solid var(--line-subtle);
  }

  .post-list > li {
    border-bottom: 1px solid var(--line-subtle);
  }

  .post-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) minmax(120px, auto);
    align-items: center;
    gap: 24px;
    padding-block: 20px;
  }

  .post-row > time {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .post-row h4 {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    padding: 0;
    list-style: none;
  }

  .post-tags li {
    padding: 3px 7px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-tertiary);
    font-size: 10px;
  }

  @media (max-width: 820px) {
    .archive-header {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .archive-overview {
      max-width: 560px;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-card {
      min-height: 0;
    }

    .featured-card h3 {
      margin-top: 24px;
    }

    .post-row {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 12px 18px;
    }

    .post-tags {
      grid-column: 2;
      justify-content: flex-start;
    }
  }

  @media (max-width: 560px) {
    .archive-header {
      gap: 28px;
    }

    .archive-overview {
      gap: 10px;
    }

    .archive-overview > a {
      min-height: 118px;
      gap: 10px;
      padding: 16px;
    }

    .overview-number {
      font-size: 30px;
    }

    .overview-copy strong {
      font-size: 14px;
    }

    .overview-copy small {
      font-size: 10px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .post-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .post-tags {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card:hover {
      transform: none;
    }
  }
</style>
