---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CapabilityBoard from '../components/CapabilityBoard.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import ContactFooter from '../components/ContactFooter.astro';
import { seo } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout description={seo.homeDescription}>
  <Hero />
  <CapabilityBoard />
  <WorkShowcase projects={projects} />
  <Experience />
  <About />
  <ContactFooter />
</BaseLayout>
