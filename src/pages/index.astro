---
import { getFeaturedProjects } from '../lib/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CapabilityBoard from '../components/CapabilityBoard.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import ContactFooter from '../components/ContactFooter.astro';
import { seo } from '../data/site';

const projects = await getFeaturedProjects();
---

<BaseLayout description={seo.homeDescription}>
  <Hero projects={projects} />
  <CapabilityBoard />
  <WorkShowcase projects={projects} />
  <Experience />
  <About />
  <ContactFooter />
</BaseLayout>
