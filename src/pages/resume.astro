---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact, experience, hero, identity, skillGroups, targetRoles, ui } from '../data/site';
import { getFeaturedProjects } from '../lib/projects';

const projects = await getFeaturedProjects();
---

<BaseLayout title="职业简历" description="李皎的公开职业简历：技术负责人 / 研发总监，18+ 年研发、架构与技术管理经验，可打印或保存为 PDF。">
  <article class="container resume">
    <div class="resume-actions">
      <a href="/"><span aria-hidden="true">←</span> 返回首页</a>
      <button type="button" data-print-resume>打印 / 保存 PDF</button>
    </div>

    <header class="resume-header">
      <span class="eyebrow">Public résumé / Shanghai</span>
      <h1>{identity.name}<span aria-hidden="true">.</span></h1>
      <p class="resume-role">{identity.roleZh}</p>
      <p class="resume-lead">{hero.lead}</p>

      <ul class="resume-contact" aria-label="公开联系方式">
        {contact.channels.map((channel) => (
          <li>
            <span>{channel.label}</span>
            {channel.href ? (
              <a href={channel.href} target={channel.external ? '_blank' : undefined} rel={channel.external ? 'noopener noreferrer' : undefined}>{channel.value}</a>
            ) : <strong>{channel.value}</strong>}
          </li>
        ))}
      </ul>

      <dl class="resume-proofs" aria-label="职业概览">
        {ui.hero.proofs.map((proof) => (
          <div><dt>{proof.label}</dt><dd>{proof.value}</dd></div>
        ))}
      </dl>
    </header>

    <section class="resume-section" aria-labelledby="resume-work">
      <div class="section-title">
        <span>01 / SELECTED WORK</span>
        <h2 id="resume-work">代表项目</h2>
      </div>
      <div class="resume-projects">
        {projects.map((project) => (
          <article class="resume-item">
            <div class="item-heading">
              <div>
                <h3><a href={`/work/${project.id}/`}>{project.data.title}</a></h3>
                <p>{project.data.role}</p>
              </div>
              <span>{project.data.period}</span>
            </div>
            <p>{project.data.summary}</p>
            {project.data.facts.length > 0 && (
              <ul class="item-facts" aria-label={`${project.data.title}关键事实`}>
                {project.data.facts.map((fact) => <li><strong>{fact.value}</strong> {fact.label}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="resume-section" aria-labelledby="resume-experience">
      <div class="section-title">
        <span>02 / EXPERIENCE</span>
        <h2 id="resume-experience">职业经历</h2>
      </div>
      <div class="resume-experience">
        {experience.map((item) => (
          <article class="resume-item">
            <div class="item-heading">
              <div>
                <h3>{item.org}</h3>
                <p>{item.title}</p>
              </div>
              <span>{item.period}</span>
            </div>
            <p>{item.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-section resume-bottom" aria-labelledby="resume-skills">
      <div>
        <div class="section-title">
          <span>03 / ENGINEERING</span>
          <h2 id="resume-skills">技术与实践</h2>
        </div>
        <div class="resume-skills">
          {skillGroups.map((group) => (
            <section>
              <h3>{group.label}</h3>
              <p>{group.items.join(' · ')}</p>
            </section>
          ))}
        </div>
      </div>
      <aside class="resume-direction" aria-labelledby="resume-direction">
        <span>04 / DIRECTION</span>
        <h2 id="resume-direction">目标方向</h2>
        <ul>
          {targetRoles.map((role) => <li>{role}</li>)}
        </ul>
        <p>AI 辅助真实生产系统研发与 LLM / RAG 内部试点分别呈现；不将内部试点描述为生产 AI 应用成果。</p>
      </aside>
    </section>
  </article>
</BaseLayout>

<script>
  document.querySelector('[data-print-resume]')?.addEventListener('click', () => window.print());
</script>

<style>
  .resume {
    max-width: 1120px;
    padding-block: clamp(116px, 13vw, 164px) var(--section-gap);
  }

  .resume-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(44px, 7vw, 80px);
  }

  .resume-actions a,
  .resume-actions button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 13px;
  }

  .resume-actions button {
    padding: 0 16px;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
    cursor: pointer;
  }

  .resume-actions a:hover {
    color: var(--accent);
  }

  .resume-header {
    padding-bottom: clamp(40px, 6vw, 64px);
    border-bottom: 1px solid var(--line-strong);
  }

  .resume-header h1 {
    margin-top: 16px;
    font-family: var(--font-serif-cn);
    font-size: var(--fs-display);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .resume-header h1 span {
    color: var(--accent);
  }

  .resume-role {
    margin-top: 20px;
    color: var(--text-primary);
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 500;
  }

  .resume-lead {
    max-width: 64ch;
    margin-top: 20px;
    color: var(--text-secondary);
    font-size: var(--fs-lead);
    line-height: 1.85;
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 28px;
  }

  .resume-contact li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 12px;
  }

  .resume-contact li > span {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .resume-contact a,
  .resume-contact strong {
    color: var(--text-primary);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .resume-proofs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 32px;
  }

  .resume-proofs > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 8px;
    padding: 18px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--layer-1);
  }

  .resume-proofs dt {
    color: var(--text-secondary);
    font-size: 12px;
  }

  .resume-proofs dd {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: clamp(24px, 3vw, 38px);
    font-weight: 350;
  }

  .resume-section {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    padding-block: clamp(40px, 6vw, 64px);
    border-bottom: 1px solid var(--line-subtle);
  }

  .section-title > span,
  .resume-direction > span {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .section-title h2,
  .resume-direction h2 {
    margin-top: 8px;
    font-family: var(--font-serif-cn);
    font-size: 28px;
    font-weight: 800;
  }

  .resume-projects,
  .resume-experience,
  .resume-skills {
    display: grid;
    gap: 28px;
  }

  .resume-item {
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line-subtle);
  }

  .resume-item:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .item-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
  }

  .item-heading h3 {
    color: var(--text-primary);
    font-size: 17px;
    font-weight: 650;
    line-height: 1.5;
  }

  .item-heading h3 a:hover {
    color: var(--accent);
  }

  .item-heading div > p {
    margin-top: 4px;
    color: var(--accent);
    font-size: 12px;
  }

  .item-heading > span {
    max-width: 240px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.7;
    text-align: right;
  }

  .resume-item > p,
  .resume-direction > p {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.8;
  }

  .item-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 14px;
    color: var(--text-secondary);
    font-size: 11px;
  }

  .item-facts strong {
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .resume-bottom {
    border-bottom: 0;
  }

  .resume-skills {
    gap: 20px;
  }

  .resume-skills h3 {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 450;
    letter-spacing: 0.08em;
  }

  .resume-skills p {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.8;
  }

  .resume-direction {
    align-self: start;
    padding: 24px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--layer-1);
  }

  .resume-direction ul {
    display: grid;
    gap: 10px;
    margin-block: 20px;
    color: var(--text-primary);
    font-size: 13px;
  }

  .resume-direction li::before {
    content: '↳';
    margin-right: 8px;
    color: var(--accent);
  }

  :global(.no-js) .resume-actions button {
    display: none;
  }

  @media (max-width: 760px) {
    .resume-section {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .item-heading {
      flex-direction: column;
      gap: 8px;
    }

    .item-heading > span {
      max-width: none;
      text-align: left;
    }
  }

  @media (max-width: 520px) {
    .resume-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .resume-proofs {
      grid-template-columns: 1fr;
    }

    .resume-contact {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 14mm;
    }

    :global(html),
    :global(body) {
      background: #fff !important;
      color: #171717 !important;
    }

    :global(.site-nav),
    :global(.site-footer),
    :global(.cursor-ambient),
    :global(.skip-link),
    .resume-actions {
      display: none !important;
    }

    .resume {
      --text-primary: #171717;
      --text-secondary: #333;
      --text-tertiary: #555;
      --line-subtle: #ddd;
      --line-strong: #bbb;
      --accent: #315700;
      --accent-border: #7a925e;
      --accent-soft: #fff;
      --layer-1: #fff;
      max-width: none;
      padding: 0;
    }

    .resume-header {
      padding-bottom: 20px;
    }

    .resume-header h1 {
      font-size: 46px;
    }

    .resume-role {
      margin-top: 10px;
      font-size: 17px;
    }

    .resume-lead {
      margin-top: 12px;
      font-size: 12px;
      line-height: 1.65;
    }

    .resume-contact,
    .resume-proofs {
      margin-top: 16px;
    }

    .resume-proofs > div,
    .resume-direction {
      border-color: #ccc;
      background: #fff;
    }

    .resume-proofs > div {
      padding: 10px;
    }

    .resume-proofs dd {
      font-size: 22px;
    }

    .resume-section {
      grid-template-columns: 130px minmax(0, 1fr);
      gap: 24px;
      padding-block: 24px;
    }

    .resume-projects,
    .resume-experience {
      gap: 18px;
    }

    .resume-item {
      break-inside: avoid;
      padding-bottom: 18px;
    }

    .resume-item > p,
    .resume-direction > p,
    .resume-skills p {
      color: #333;
      font-size: 11px;
    }

    .resume-header h1,
    .resume-role,
    .item-heading h3,
    .item-facts strong,
    .resume-contact a,
    .resume-contact strong,
    .resume-direction ul {
      color: #171717;
    }

    .resume-proofs dd,
    .item-heading div > p,
    .resume-direction li::before {
      color: #315700;
    }

    .section-title h2,
    .resume-direction h2 {
      font-size: 22px;
    }

    .resume-bottom {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
